{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bem Buckets Entity Bulk Seed API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Entity Bulk Seed",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Bulk Seed Entities",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.bem.ai/v3/entities/bulk",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Bulk Seed Entities"
        },
        {
          "info": {
            "name": "Get Seed Job Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bem.ai/v3/entities/seed/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Seed job public ID (`esj_...`)."
              }
            ]
          },
          "docs": "Get Seed Job Status"
        }
      ]
    }
  ],
  "bundled": true
}