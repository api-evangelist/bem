                "url": {
                  "raw": "{{baseUrl}}/v3/outputs?limit=50&callIDs=<string>&workflowIDs=<string>&workflowNames=<string>&functionIDs=<string>&functionNames=<string>&referenceIDs=<string>&eventIDs=<string>&eventTypes=<string>&transformationIDs=<string>&functionVersionNums=<integer>&referenceIDSubstring=<string>&isLabelled=<boolean>&isRegression=<boolean>&includeIntermediate=<boolean>&sortOrder=asc&startingAfter=<string>&endingBefore=<string>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "v3",
                    "outputs"
                  ],
                  "query": [
                    {
                      "key": "limit",
                      "value": "50"
