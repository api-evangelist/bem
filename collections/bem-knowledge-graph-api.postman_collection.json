    {
      "name": "v3",
      "item": [
        {
          "name": "entities",
          "item": [
            {
              "name": "{id}",
              "item": [
                {
                  "name": "relations",
                  "item": [
                    {
                      "name": "Get an Entity's Relations",
                      "id": "07a779fe-f8b8-47ab-bf54-b76d5a5c52de",
                      "protocolProfileBehavior": {
                        "disableBodyPruning": true
                      },
                      "request": {
                        "method": "GET",
                        "header": [
                          {
                            "key": "Accept",
                            "value": "application/json"
                          }
                        ],
                        "url": {
                          "raw": "{{baseUrl}}/v3/entities/:id/relations?direction=inbound&relationType=<string>&limit=<integer>&cursor=<string>&bucket=<string>",
                          "host": [
                            "{{baseUrl}}"
                          ],
                          "path": [
                            "v3",
                            "entities",
                            ":id",
                            "relations"
                          ],
                          "query": [
                            {
                              "description": "Which edges to return relative to the entity. Defaults to `both`.",
                              "key": "direction",
                              "value": "inbound"
                            },
                            {
                              "description": "Exact-match filter on the relation label.",
                              "key": "relationType",
                              "value": "<string>"
                            },
                            {
                              "description": "Maximum number of edges to return (default 50, max 200).",
                              "key": "limit",
                              "value": "<integer>"
                            },
                            {
                              "description": "Cursor: return edges whose KSUID sorts after this value.",
                              "key": "cursor",
                              "value": "<string>"
                            },
                            {
                              "description": "Optional bucket public ID (`bkt_...`) to scope the read to one bucket.\nOmit for the unscoped (all account+environment) view.",
                              "key": "bucket",
                              "value": "<string>"
                            }
                          ],
                          "variable": [
                            {
                              "id": "7f6acb43-f02e-4b5a-abc0-3e358232d85d",
                              "key": "id",
                              "value": "<string>",
                              "description": "(Required) Entity public ID (`ent_...`). A merged-away id transparently resolves to the surviving entity."
                            }
                          ]
                        }
                      },
                      "response": [
                        {
                          "id": "58cced3e-cbb5-4df2-b8b2-7559d418143b",
                          "name": "The request has succeeded.",
                          "originalRequest": {
                            "method": "GET",
                            "header": [
                              {
                                "key": "Accept",
                                "value": "application/json"
                              }
                            ],
                            "url": {
                              "raw": "{{baseUrl}}/v3/entities/:id/relations?direction=inbound&relationType=<string>&limit=<integer>&cursor=<string>&bucket=<string>",
                              "host": [
                                "{{baseUrl}}"
                              ],
                              "path": [
                                "v3",
                                "entities",
                                ":id",
                                "relations"
                              ],
                              "query": [
                                {
                                  "description": "Which edges to return relative to the entity. Defaults to `both`.",
                                  "key": "direction",
                                  "value": "inbound"
                                },
                                {
                                  "description": "Exact-match filter on the relation label.",
                                  "key": "relationType",
                                  "value": "<string>"
                                },
                                {
                                  "description": "Maximum number of edges to return (default 50, max 200).",
                                  "key": "limit",
                                  "value": "<integer>"
                                },
                                {
                                  "description": "Cursor: return edges whose KSUID sorts after this value.",
                                  "key": "cursor",
                                  "value": "<string>"
                                },
                                {
                                  "description": "Optional bucket public ID (`bkt_...`) to scope the read to one bucket.\nOmit for the unscoped (all account+environment) view.",
                                  "key": "bucket",
                                  "value": "<string>"
                                }
                              ],
                              "variable": [
                                {
                                  "key": "id"
                                }
                              ]
                            }
                          },
                          "status": "OK",
                          "code": 200,
                          "_postman_previewlanguage": "json",
                          "header": [
                            {
                              "key": "Content-Type",
                              "value": "application/json"
                            }
                          ],
                          "cookie": [],
                          "responseTime": null,
                          "body": "{\n  \"inbound\": [\n    {\n      \"relationType\": \"<string>\",\n      \"sourceEntity\": {\n        \"id\": \"<string>\",\n        \"canonical\": \"<string>\",\n        \"type\": \"<string>\",\n        \"depth\": \"<integer>\"\n      },\n      \"mentionCount\": \"<integer>\",\n      \"firstSeenAt\": \"<dateTime>\"\n    },\n    {\n      \"relationType\": \"<string>\",\n      \"sourceEntity\": {\n        \"id\": \"<string>\",\n        \"canonical\": \"<string>\",\n        \"type\": \"<string>\",\n        \"depth\": \"<integer>\"\n      },\n      \"mentionCount\": \"<integer>\",\n      \"firstSeenAt\": \"<dateTime>\"\n    }\n  ],\n  \"outbound\": [\n    {\n      \"relationType\": \"<string>\",\n      \"targetEntity\": {\n        \"id\": \"<string>\",\n        \"canonical\": \"<string>\",\n        \"type\": \"<string>\",\n        \"depth\": \"<integer>\"\n      },\n      \"mentionCount\": \"<integer>\",\n      \"firstSeenAt\": \"<dateTime>\"\n    },\n    {\n      \"relationType\": \"<string>\",\n      \"targetEntity\": {\n        \"id\": \"<string>\",\n        \"canonical\": \"<string>\",\n        \"type\": \"<string>\",\n        \"depth\": \"<integer>\"\n      },\n      \"mentionCount\": \"<integer>\",\n      \"firstSeenAt\": \"<dateTime>\"\n    }\n  ],\n  \"nextCursor\": \"<string>\"\n}",
                          "createdAt": "2026-10-22T02:02:39.000Z",
