{
  "info": {
    "_postman_id": "b385f50e-1e1c-4d4c-917b-d0d417462afc",
    "name": "Bem Knowledge Graph API",
    "description": "Read the cross-document knowledge graph \u2014 the canonical entities and the\ndirected relations between them that the Parse pipeline populates when\n`linkAcrossDocuments` is enabled.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-22T02:02:38.000Z",
    "updatedAt": "2026-10-22T02:02:39.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-b385f50e-1e1c-4d4c-917b-d0d417462afc"
  },
