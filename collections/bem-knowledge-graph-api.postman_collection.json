        },
        {
          "name": "knowledge-graph",
          "item": [
            {
              "name": "Retrieve the Knowledge Graph",
              "id": "78671016-f78c-47d3-86e7-d8ba07de7c3a",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/v3/knowledge-graph?nodeID=<string>&maxDepth=<integer>&limit=<integer>&cursor=<string>&type=<string>,<string>&since=<dateTime>&search=<string>&bucket=<string>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "v3",
                    "knowledge-graph"
                  ],
                  "query": [
                    {
                      "description": "Center the graph on this entity (`ent_...`) and only return the subgraph\nwithin `maxDepth` hops of it; every node then carries its `depth` (hops\nfrom the center, center = 0). Omit for the uncentered whole-graph view.\n`rootNodeID` and `focusNodeID` are accepted as aliases.",
                      "key": "nodeID",
                      "value": "<string>"
                    },
                    {
                      "description": "Maximum hops from the center node. Only meaningful with `nodeID`. Defaults\nto 2 and is clamped down to a system maximum (5).",
                      "key": "maxDepth",
                      "value": "<integer>"
                    },
                    {
                      "description": "Maximum number of edges per page (default 50, max 200).",
                      "key": "limit",
                      "value": "<integer>"
                    },
                    {
                      "description": "Cursor: return edges whose KSUID sorts after this value.",
                      "key": "cursor",
                      "value": "<string>"
                    },
                    {
                      "description": "Restrict to entities of these types. An edge is returned only when BOTH\nof its endpoints survive the type filter.",
                      "key": "type",
                      "value": "<string>,<string>"
                    },
                    {
                      "description": "Only edges created at/after this RFC 3339 timestamp.",
                      "key": "since",
                      "value": "<dateTime>"
                    },
                    {
                      "description": "Case-insensitive substring match on canonical names. Both endpoints of an\nedge must match for the edge (and its nodes) to be returned.",
                      "key": "search",
                      "value": "<string>"
                    },
                    {
                      "description": "Optional bucket public ID (`bkt_...`) to scope the read to one bucket.\nOmit for the unscoped (all account+environment) view.",
                      "key": "bucket",
                      "value": "<string>"
                    }
                  ]
                }
              },
              "response": [
                {
                  "id": "3bfe45b5-5a2d-44b3-97e4-3719337d2b53",
                  "name": "The request has succeeded.",
                  "originalRequest": {
                    "method": "GET",
                    "header": [
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/v3/knowledge-graph?nodeID=<string>&maxDepth=<integer>&limit=<integer>&cursor=<string>&type=<string>,<string>&since=<dateTime>&search=<string>&bucket=<string>",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "v3",
                        "knowledge-graph"
                      ],
                      "query": [
                        {
                          "description": "Center the graph on this entity (`ent_...`) and only return the subgraph\nwithin `maxDepth` hops of it; every node then carries its `depth` (hops\nfrom the center, center = 0). Omit for the uncentered whole-graph view.\n`rootNodeID` and `focusNodeID` are accepted as aliases.",
                          "key": "nodeID",
                          "value": "<string>"
                        },
                        {
                          "description": "Maximum hops from the center node. Only meaningful with `nodeID`. Defaults\nto 2 and is clamped down to a system maximum (5).",
                          "key": "maxDepth",
                          "value": "<integer>"
                        },
                        {
                          "description": "Maximum number of edges per page (default 50, max 200).",
                          "key": "limit",
                          "value": "<integer>"
                        },
                        {
                          "description": "Cursor: return edges whose KSUID sorts after this value.",
                          "key": "cursor",
                          "value": "<string>"
                        },
                        {
                          "description": "Restrict to entities of these types. An edge is returned only when BOTH\nof its endpoints survive the type filter.",
                          "key": "type",
                          "value": "<string>,<string>"
                        },
                        {
                          "description": "Only edges created at/after this RFC 3339 timestamp.",
                          "key": "since",
                          "value": "<dateTime>"
                        },
                        {
                          "description": "Case-insensitive substring match on canonical names. Both endpoints of an\nedge must match for the edge (and its nodes) to be returned.",
                          "key": "search",
                          "value": "<string>"
                        },
                        {
                          "description": "Optional bucket public ID (`bkt_...`) to scope the read to one bucket.\nOmit for the unscoped (all account+environment) view.",
                          "key": "bucket",
                          "value": "<string>"
                        }
                      ]
                    }
                  },
                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "json",
                  "header": [
                    {
                      "key": "Content-Type",
                      "value": "application/json"
                    }
                  ],
                  "cookie": [],
                  "responseTime": null,
                  "body": "{\n  \"nodes\": [\n    {\n      \"id\": \"<string>\",\n      \"canonical\": \"<string>\",\n      \"type\": \"<string>\",\n      \"mentionCount\": \"<integer>\",\n      \"depth\": \"<integer>\"\n    },\n    {\n      \"id\": \"<string>\",\n      \"canonical\": \"<string>\",\n      \"type\": \"<string>\",\n      \"mentionCount\": \"<integer>\",\n      \"depth\": \"<integer>\"\n    }\n  ],\n  \"edges\": [\n    {\n      \"sourceId\": \"<string>\",\n      \"targetId\": \"<string>\",\n      \"relationType\": \"<string>\",\n      \"mentionCount\": \"<integer>\"\n    },\n    {\n      \"sourceId\": \"<string>\",\n      \"targetId\": \"<string>\",\n      \"relationType\": \"<string>\",\n      \"mentionCount\": \"<integer>\"\n    }\n  ],\n  \"nextCursor\": \"<string>\"\n}",
                  "createdAt": "2026-10-22T02:02:39.000Z",
                  "updatedAt": "2026-10-22T02:02:39.000Z",
                  "uid": "35240-3bfe45b5-5a2d-44b3-97e4-3719337d2b53"
                }
              ],
              "createdAt": "2026-10-22T02:02:39.000Z",
              "updatedAt": "2026-10-22T02:02:39.000Z",
