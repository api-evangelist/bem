{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bem Buckets Entity Curation API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Entity Curation",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Bulk Validate Entities",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.bem.ai/v3/entities/bulk-validate",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Bulk Validate Entities"
        },
        {
          "info": {
            "name": "Update Entity",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.bem.ai/v3/entities/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Entity public ID (`ent_...`). A merged-away id resolves to its survivor."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update Entity"
        }
      ]
    }
  ],
  "bundled": true
}