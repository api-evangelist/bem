                      "name": "Submit Event Feedback",
                      "id": "4c05624e-307b-4d33-a15e-6ff87986d8f4",
                      "protocolProfileBehavior": {
                        "disableBodyPruning": true
                      },
                      "request": {
                        "method": "POST",
                        "header": [
                          {
                            "key": "Content-Type",
                            "value": "application/json"
                          },
                          {
                            "key": "Accept",
                            "value": "application/json"
                          }
                        ],
                        "body": {
                          "mode": "raw",
                          "raw": "{\n  \"correction\": {},\n  \"orderMatching\": \"<boolean>\"\n}",
                          "options": {
                            "raw": {
                              "headerFamily": "json",
                              "language": "json"
                            }
                          }
                        },
                        "url": {
                          "raw": "{{baseUrl}}/v3/events/:eventID/feedback",
                          "host": [
                            "{{baseUrl}}"
                          ],
                          "path": [
                            "v3",
                            "events",
                            ":eventID",
                            "feedback"
                          ],
                          "variable": [
                            {
                              "id": "2e3cee63-f0d8-4917-b8e7-92ab22f59d13",
                              "key": "eventID",
                              "value": "<string>",
                              "description": "(Required) The unique identifier of the event being corrected."
                            }
                          ]
                        },
                        "description": "**Submit a correction for an event.**\n\nAccepts training corrections for `extract`, `classify`, and `join` events.\nFor extract/join events, `correction` is a JSON object matching the function's\noutput schema. For classify events, `correction` is a JSON string matching\none of the function version's declared classifications.\n\nSubmitting feedback again for the same event overwrites the previous correction.\n\nUnsupported function types (split, enrich) return `400`."
                      },
