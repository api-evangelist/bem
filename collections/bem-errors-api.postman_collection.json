  "item": [
    {
      "id": "06e86c19-aa1a-487e-9b52-c4b5ff4f8ad6",
      "name": "Errors",
      "description": {
        "content": "Retrieve terminal error events from workflow calls.\n\nErrors are events produced by function steps that failed during processing. A single workflow\ncall may produce multiple error events if several steps fail independently.\n\nErrors and outputs from the same call are not mutually exclusive: a partially-completed\nworkflow may have both.\n\nUse `GET /v3/errors` to list errors across calls, or `GET /v3/errors/{eventID}` to retrieve\na specific error. To get errors scoped to a single call, filter by `callIDs`.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "0f12c94d-6239-47dc-abcc-ae6aaf272eb2",
          "name": "List Errors",
          "request": {
            "name": "List Errors",
            "description": {
              "content": "**List terminal error events.**\n\nReturns error events produced by failed function calls within workflow executions.\nNon-error output events are excluded; use `GET /v3/outputs` to retrieve those.\n\n## Filtering\n\nFilter by call, workflow, function, or reference ID. Multiple filters are ANDed together.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "errors"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "50"
                },
                {
                  "disabled": false,
                  "key": "callIDs",
                  "value": "<string>",
                  "description": "Filter to errors from specific calls."
