onCallID\": \"<string>\",\n        \"sourceEventID\": \"<string>\",\n        \"workflowCallID\": \"<string>\",\n        \"workflowNodeName\": \"<string>\",\n        \"incomingDestinationName\": \"<string>\",\n        \"inputType\": \"<string>\",\n        \"s3URL\": \"<string>\",\n        \"inputs\": [\n          {\n            \"inputType\": \"<string>\",\n            \"itemReferenceID\": \"<string>\",\n            \"s3URL\": \"<string>\"\n          },\n          {\n            \"inputType\": \"<string>\",\n            \"itemReferenceID\": \"<string>\",\n            \"s3URL\": \"<string>\"\n          }\n        ]\n      }\n    ],\n    \"events\": []\n  },\n  \"error\": \"<string>\"\n}",
